# creatorloop settings. `creatorloop-setup` creates this file in your creatorloop home folder;
# fill in the two required values below and restart Claude Desktop.
# Commands below are for a PyPI install; from a source checkout use `uv run creatorloop-auth ...`.

# Long-lived user access token (60 days) or a System User token (never expires).
# Get it with: uvx --from creatorloop creatorloop-auth exchange --short-token <TOKEN> --write
IG_ACCESS_TOKEN=

# Instagram professional account ID (NOT the username). 17841400000000000-like number.
# Get it with: uvx --from creatorloop creatorloop-auth whoami --write
IG_USER_ID=

# Graph API version. Check https://developers.facebook.com/docs/graph-api/changelog
GRAPH_API_VERSION=v26.0

# Optional: needed only for the token exchange and token expiry check.
META_APP_ID=
META_APP_SECRET=

# Optional: SQLite database location (default: creatorloop.db in the creatorloop home folder).
IG_DB_PATH=

# Optional: IANA timezone for "best time to post" and the queue, e.g. Europe/Berlin.
# Default: your computer's timezone (on Windows set it explicitly to get daylight-saving changes right).
IG_TIMEZONE=

# Optional: publishing slots for queue_post(when="next"), local time. Example, not a recommendation.
QUEUE_SLOTS=Tue,Thu,Sun 19:00

# Cache TTL in minutes.
CACHE_TTL_PROFILE_MIN=60
CACHE_TTL_MEDIA_MIN=180
CACHE_TTL_HASHTAG_MIN=360
