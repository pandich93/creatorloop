# creatorloop settings. `creatorloop-setup` creates this file in your creatorloop home folder and fills
# IG_ACCESS_TOKEN, IG_USER_ID, META_APP_ID and META_APP_SECRET through the setup page in your browser.
# Connect again any time: `uvx --from creatorloop creatorloop-auth login` (or ask Claude to run open_setup).

# Long-lived user access token (60 days) or a System User token (never expires). Filled by the setup page.
IG_ACCESS_TOKEN=

# Instagram professional account ID (NOT the username). 17841400000000000-like number. Filled by the setup page.
IG_USER_ID=

# Graph API version. Check https://developers.facebook.com/docs/graph-api/changelog
GRAPH_API_VERSION=v26.0

# Your Meta app. Filled by the setup page; also used for the token expiry check.
META_APP_ID=
META_APP_SECRET=

# Optional: SQLite database location (default: creatorloop.db in the creatorloop home folder).
IG_DB_PATH=

# Optional: IANA timezone for "best time to post" and the queue, e.g. Europe/Berlin.
# Default: your computer's timezone (on Windows set it explicitly to get daylight-saving changes right).
IG_TIMEZONE=

# Optional: publishing slots for queue_post(when="next"), local time. Example, not a recommendation.
QUEUE_SLOTS=Tue,Thu,Sun 19:00

# Cache TTL in minutes.
CACHE_TTL_PROFILE_MIN=60
CACHE_TTL_MEDIA_MIN=180
CACHE_TTL_HASHTAG_MIN=360
